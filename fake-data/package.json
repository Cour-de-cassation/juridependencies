{
  "name": "juridependencies",
  "version": "0.0.1",
  "description": "Juridependencies fake datas",
  "author": "Cour de Cassation",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dbdsi:templates": "node dbdsi/replace.js",
    "dbdsi:migrate:up": "node dbdsi/migrate.js up",
    "dbdsi:migrate:down": "node dbdsi/migrate.js down",
    "dbdsi:seeds": "npm run dbdsi:migrate:down && npm run dbdsi:migrate:up && node dbdsi/seed.js",
    "dbsder:seeds": "node dbsder/clean.js && node dbsder/load.js",
    "dbdsimongo:seeds": "node dbdsimongo/clean.js && node dbdsimongo/generate.js && node dbdsimongo/load.js",
    "label:seeds": "node label/clean.js && node label/load.js",
    "juripilot:seeds": "node juripilot/clean.js && node juripilot/load.js",
    "index:seeds": "node index/clean.js && node index/load.js",
    "rawfiles:seeds": "node rawfiles/clean.js && node rawfiles/load.js",
    "bucket:seeds": "node bucket/clean.js && node bucket/load.js",
    "seeds": "npm run dbdsi:seeds && npm run dbsder:seeds && npm run label:seeds && npm run juripilot:seeds && npm run index:seeds && npm run rawfiles:seeds && npm run bucket:seeds"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1050.0",
    "axios": "1.18.1",
    "commander": "14.0.3",
    "dotenv": "17.4.2",
    "iconv-lite": "0.7.2",
    "mongodb": "7.2.0",
    "oracledb": "6.10.0",
    "simple-oauth2": "5.1.0"
  }
}
